# Copy to .env.local. NEVER commit real values. NEVER put the service-role key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The login email for the single shared account (not secret). The password is set only in the Supabase dashboard.
VITE_LOGIN_EMAIL=
# Local development only. Ignored in production builds.
VITE_DEMO_MODE=false
